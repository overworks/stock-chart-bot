{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-chart-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    // 로컬 검증용 ID이며, 배포 전 본인의 KV 네임스페이스 ID로 변경한다.
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ALIAS_WRITER", "class_name": "AliasWriter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AliasWriter"] }],
  "r2_buckets": [
    { "binding": "CHARTS", "bucket_name": "your-r2-bucket-name" }
  ]
}
