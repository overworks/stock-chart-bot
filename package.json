{
  "name": "stock-chart-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "setup:wasm": "mkdir -p wasm && cp node_modules/@resvg/resvg-wasm/index_bg.wasm wasm/resvg.wasm",
    "postinstall": "npm run setup:wasm",
    "register": "tsx scripts/register-commands.ts",
    "smoke": "tsx scripts/smoke.ts",
    "seed:symbols": "wrangler kv key put symbols:v1 --path scripts/symbols.json --binding SYMBOLS --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:symbols": "tsx scripts/fetch-krx-symbols.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  }
}
