{
  "name": "stock-chart-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "setup:wasm": "mkdir -p wasm && cp node_modules/@resvg/resvg-wasm/index_bg.wasm wasm/resvg.wasm",
    "postinstall": "npm run setup:wasm",
    "register": "tsx scripts/register-commands.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.0"
  }
}
